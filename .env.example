# Copy to .env and fill in your values.
# Expo exposes EXPO_PUBLIC_* vars to the JS bundle at build time.

# Backend API base URL (no trailing slash).
# NOTE: EXPO_PUBLIC_* vars are inlined at BUNDLE time — after editing this you must
# restart Metro with a cleared cache (`npx expo start -c`) or rebuild for it to apply.
# For quick changes on a device, use the in-app "Server settings" screen (Login →
# "Server settings", or Profile → "Server settings"), which overrides this at runtime.
# On a physical device use your computer's LAN IP (not localhost/10.0.2.2).
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8002/api/v1

# Agora App ID (from Agora Console → Project Management)
EXPO_PUBLIC_AGORA_APP_ID=

# Google Maps Android API key (Google Cloud Console → APIs & Services → Credentials).
# Enable "Maps SDK for Android" for the key. Required for the Nearby Vets map and
# the clinic map on Vet Detail. Without it, maps render grey tiles (no crash).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
